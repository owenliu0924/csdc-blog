---
import type { CollectionEntry } from 'astro:content'

interface Props {
  prev?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
  class?: string
}

const { prev, next, class: className } = Astro.props
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-4" class:list={[className]}>
  <div>
    {
      prev && (
        <a class="flex items-baseline gap-2 hover:text-accent" href={`/posts/${prev.slug}`}>
          <i class="shrink-0 iconfont icon-arrow-left" />
          <span class="line-clamp-2 sm:line-clamp-none">{prev.data.title}</span>
        </a>
      )
    }
  </div>
  <div>
    {
      next && (
        <a
          class="flex items-baseline justify-start sm:justify-end gap-2 hover:text-accent"
          href={`/posts/${next.slug}`}
        >
          <span class="line-clamp-2 sm:line-clamp-none">{next.data.title}</span>
          <i class="shrink-0 iconfont icon-arrow-right" />
        </a>
      )
    }
  </div>
</div>
